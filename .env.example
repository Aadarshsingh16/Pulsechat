# Database Configuration
# Local development uses SQLite; Production uses PostgreSQL (e.g. Render / Neon / Supabase)
DATABASE_URL="file:./dev.db"

# Authentication Secret (Generate a strong 32+ character random string in production)
JWT_SECRET="pulsechat_super_secure_jwt_secret_key_2026"

# Server Port & URLs (Merged Single-Process Server — Next.js and Socket.IO share PORT)
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"
NODE_ENV="development"

# Object Storage (Cloudflare R2 / AWS S3)
# Leave blank to use local disk storage in public/uploads/
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key"
# R2_SECRET_ACCESS_KEY="your_r2_secret_key"
# R2_BUCKET_NAME="pulsechat-media"
# R2_PUBLIC_URL="https://media.pulsechat.io"

# Media Upload Limits & Moderation Settings
MAX_UPLOAD_SIZE_MB=5
MODERATION_STRICT_MODE="true"

# Giphy API Key (Optional — fallback trending sticker/GIF library used if empty)
GIPHY_API_KEY=""

# Database Configuration (Neon / Supabase PostgreSQL for Production, SQLite file:./dev.db for local)
DATABASE_URL=

# Authentication Secret (32+ character random string)
JWT_SECRET=

# Environment Mode
NODE_ENV=production

# Cloudinary Configuration (Direct Signed Client-to-Cloud Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# (Deprecated) Cloudflare R2 Object Storage (Required for persistent uploads on Render)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Optional Configuration
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SOCKET_URL=
MAX_UPLOAD_SIZE_MB=5
MODERATION_STRICT_MODE=true
GIPHY_API_KEY=
